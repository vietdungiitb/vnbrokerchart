{
  "name": "vnstockcharts",
  "version": "1.0.0",
  "description": "Highly customizable stock charts with ReactJS and d3 - Modernized",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "author": {
    "name": "Phạm Việt Dũng",
    "email": "vietdung@edusuccess.vn"
  },
  "homepage": "https://vninvest.edusuccess.vn",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf -rf ./build ./dist",
    "build": "tsup",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "watch": "npm run clean && cross-env IP=0.0.0.0 PORT=3000 webpack serve --config config/webpack.config.js",
    "build:docs": "cross-env NODE_ENV=production webpack --config config/webpack.config.js",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:soak": "vitest run tests/soak"
  },
  "dependencies": {
    "d3-array": "^3.2.0",
    "d3-force": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "debug": "^4.3.4",
    "lodash.flattendeep": "^4.4.0",
    "prop-types": "^15.8.1",
    "save-svg-as-png": "^1.4.17"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.23.0",
    "@storybook/react-vite": "^10.3.6",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-loader": "^9.2.1",
    "babel-plugin-transform-flow-strip-types": "^6.22.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.51.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.3",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^5.0.5",
    "storybook": "^10.3.6",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.10",
    "vitest": "^1.6.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
